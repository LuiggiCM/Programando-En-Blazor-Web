@page "/"
@rendermode InteractiveServer // Sirve para habilitar el modo interactivo en esta página.

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<hr />

<button @onclick="CambiarMensaje">Presióname</button> @*Ahora este botón va a funcionar, ya que se habilitó el modo interactivo en esta página.*@

<p>Mensaje: @mensaje</p>

@code {
    string mensaje = "Un mensaje";

    void CambiarMensaje()
    {
        mensaje = "Otro mensaje";
    }
}
