@page "/counter"
@rendermode InteractiveAuto // Con esto se activa el modo interactivo automático: en la 1era carga usa al servidor, en 2do plano descarga las librerías .wasm y luego cambia al modo interactivo cliente.
@attribute [StreamRendering]

<PageTitle>Counter</PageTitle>

@* `RendererInfo` contiene información del modo de renderizado y si este está en modo interactivo o no. *@
<h1>Modo de renderizado: @RendererInfo.Name</h1>
<h3>¿Interactivo? @RendererInfo.IsInteractive</h3>

<hr />

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount"
disabled="@(!RendererInfo.IsInteractive)" @*Se aprovecha la propiedad de `RendererInfo` para poder deshabilitar el botón si el contenido aún no está listo (mientras se renderiza la página). *@
>Click me</button>

@code {

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(2000); // Simulación de carga.
    }


    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
