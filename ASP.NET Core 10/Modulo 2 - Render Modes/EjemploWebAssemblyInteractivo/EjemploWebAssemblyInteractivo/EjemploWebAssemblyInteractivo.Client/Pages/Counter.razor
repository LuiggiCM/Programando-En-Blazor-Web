@page "/counter"
@rendermode InteractiveWebAssembly // Sirve para habilitar el modo interactivo local en esta página. Lo que provocará que se descargue archivos .wasm para que la página funcione de manera interactiva en el navegador del cliente.

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
